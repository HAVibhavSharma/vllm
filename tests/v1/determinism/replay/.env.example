# Copy to .env (same directory) and fill in. Real env vars take precedence.

# Number of sequential replay tries per case.
N_TRIES=5

# LangSmith: used both to re-fetch original run payloads and to log
# replay tries (one project per case: repro-<case_id>).
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# The ORIGINAL serving endpoint (OpenAI-compatible, e.g. vLLM server).
# Replays use the exact original model/params from the trace.
REPLAY_MODEL_BASE_URL=http://localhost:8000/v1
REPLAY_MODEL_API_KEY=EMPTY

# Where the trace-analyser checkout + trace_analysis_*.json reports live.
# divergence()/NOISE are imported from trace_analyser.py found here.
TRACE_ANALYSIS_DIR=~/Projects/trace-analyser

# Prefix for per-case LangSmith projects.
REPLAY_LS_PROJECT_PREFIX=repro

# vLLM batch-invariance suite tiers (all default ON).
RUN_VLLM_ENGINE_TESTS=1
RUN_VLLM_ONLINE_TESTS=1
RUN_VLLM_KERNEL_TESTS=1
